{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "专注时钟",
  "version": "0.1.0",
  "identifier": "com.focus.timer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "专注时钟",
        "width": 340,
        "height": 200,
        "minWidth": 220,
        "minHeight": 120,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
